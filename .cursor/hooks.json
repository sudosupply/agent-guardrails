{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      { "command": "python3 .guardrails/guard.py cursor-shell", "timeout": 10, "failClosed": true }
    ],
    "beforeReadFile": [
      { "command": "python3 .guardrails/guard.py cursor-read", "timeout": 10 }
    ],
    "preToolUse": [
      { "command": "python3 .guardrails/guard.py cursor-write", "matcher": "Write", "timeout": 10 }
    ]
  }
}
