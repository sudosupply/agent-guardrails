{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.test)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/credentials.json)",
      "Read(./**/secrets.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(mkfs *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(dropdb *)",
      "Bash(terraform destroy *)",
      "Bash(terraform apply *)",
      "Bash(kubectl delete *)",
      "Bash(helm uninstall *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Bash(npm publish *)",
      "Bash(printenv *)",
      "Bash(env)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.guardrails/guard.py\" claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
